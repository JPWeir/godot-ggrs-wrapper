[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://../target/debug/libgodot_ggrs_wrapper.so"
linux.release.x86_64 =   "res://../target/release/libgodot_ggrs_wrapper.so"
windows.debug.x86_64 =   "res://../target/debug/godot_ggrs_wrapper.dll"
windows.release.x86_64 = "res://../target/release/godot_ggrs_wrapper.dll"
macos.debug =            "res://../target/debug/libgodot_ggrs_wrapper.dylib"
macos.release =          "res://../target/release/libgodot_ggrs_wrapper.dylib"
macos.debug.arm64 =      "res://../target/debug/libgodot_ggrs_wrapper.dylib"
macos.release.arm64 =    "res://../target/release/libgodot_ggrs_wrapper.dylib"